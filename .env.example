# Supabase — create a fresh project at https://supabase.com/dashboard,
# then run supabase/migrations/0001_init.sql in its SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project Settings → API keys → service_role (server-only, never exposed)
SUPABASE_SERVICE_ROLE_KEY=

# Guards /api/close (Vercel Cron sends it as a Bearer token automatically
# when set in the Vercel project env). Any long random string.
CRON_SECRET=

# Optional — Cloudflare Turnstile human check on run start. Create a widget
# ("managed" mode) at https://dash.cloudflare.com → Turnstile with both
# flappybid.lol and localhost as hostnames. With neither set the check is
# off and the game behaves exactly as before; both are needed for it to run.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional — locks the origin to Cloudflare traffic. Set any long random
# string here AND add a Cloudflare Transform Rule (Rules → Transform →
# Modify Request Header) that sets x-proxy-secret to the same value on all
# requests to flappybid.lol. Requests missing the header (i.e. hitting the
# Railway origin directly, where cf-connecting-ip can be spoofed) are then
# refused by every game/write endpoint. Off while unset.
CF_PROXY_SECRET=

# Optional — dedicated salt for device IP hashing (falls back to CRON_SECRET,
# then a constant). WARNING: changing the effective salt rotates every stored
# device identity — bans, PH votes, careers — so set it once, deliberately.
IP_HASH_SALT=

# Optional — sponsor slots. Without these the Advertise modal shows but
# payment returns a friendly "not configured" error.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — crypto coin top-ups (NOWPayments), the "pay with crypto" option
# next to card. Without these the crypto button returns a friendly "not
# configured" error and card still works. API key from the NOWPayments
# dashboard (Settings → API keys); IPN secret from Settings → IPN/Payments
# (add a callback at /api/nowpayments/webhook — IPN is signed with this secret).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Optional — unavatar.io PRO secret key (sk_…) for X avatar pulls. Lifts the
# 25 requests/day anonymous rate limit; $0.01 per non-cached request.
# Get one at https://unavatar.io → Dashboard.
UNAVATAR_API_KEY=

# Optional — GIFs in chat. Either key works alone; with both set the picker
# interleaves results from the two services. Without either the gif picker
# returns a friendly "not configured" error.
#   Tenor: Google Cloud project → enable the Tenor API → API key from
#   https://console.cloud.google.com/apis/credentials
TENOR_API_KEY=
#   GIPHY: create an API key (SDK type is fine) at
#   https://developers.giphy.com/dashboard/
GIPHY_API_KEY=

# Optional — "link 𝕏" in chat (verified @handles on messages). Create an app
# at https://developer.x.com, enable OAuth 2.0 as a confidential Web App, and
# register both callback URLs:
#   https://flappybid.lol/api/x/callback
#   http://localhost:3000/api/x/callback
# Without these the link button returns a friendly "not configured" error.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Detector tuning (all optional) ───────────────────────────────────────
# Bot-detection bars. Every one falls back to a deliberately LOOSE default
# in src/game/thresholds.ts — enough to catch blatant automation and little
# else, which is the right failure mode for a fresh install (a missed bot is
# cheap, a banned human is not).
#
# Tighten them for your own deployment. Publishing the numbers you actually
# run on lets a solver author sit just outside them, which is why they live
# here rather than in source.
#
# DETECT_* are ban-grade (src/game/detect.ts).
# SUSPICION_* only colour advisory chips in /admin; they never auto-ban.
#
# DETECT_METRONOME_MIN_FLAPS=
# DETECT_METRONOME_MAX_STDDEV=
# DETECT_RAILGUN_MIN_PIPES=
# DETECT_RAILGUN_MAX_STDDEV=
# DETECT_BURST_MIN_INTERVALS=
# DETECT_BURST_MAX_INTERVAL=
# DETECT_BURST_FRACTION=
# DETECT_QUANTIZED_MIN_FLAPS=
# DETECT_QUANTIZED_TOP2_FRACTION=
#
# SUSPICION_* — see src/game/thresholds.ts for the full list and defaults.
